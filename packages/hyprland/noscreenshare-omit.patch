+bool CScreenshareFrame::shouldOmitHidden() const {
+    static auto POMIT = CConfigValue<Config::BOOL>("render:no_screen_share_omit");
+
+    if (!*POMIT || (m_session->m_type != SHARE_MONITOR && m_session->m_type != SHARE_REGION))
+        return false;
+
+    const auto PMONITOR = m_session->monitor();
+    if (!PMONITOR || PMONITOR->isMirror() || PMONITOR->m_transform != WL_OUTPUT_TRANSFORM_NORMAL || g_pSessionLockManager->isSessionLocked())
+        return false;
+
+    // only pay for a second scene render if something is actually hidden on this monitor
+    for (auto const& l : Desktop::layerState()->layers()) {
+        if (!l->m_ruleApplicator->noScreenShare().valueOrDefault())
+            continue;
+        if (l->mapped() && l->acceptsInput() && l->alphaNonZero())
+            return true;
+    }
+
+    for (auto const& w : Desktop::windowState()->windows()) {
+        if (!w->m_ruleApplicator->noScreenShare().valueOrDefault())
+            continue;
+        if (w->isHidden() || !g_pHyprRenderer->shouldRenderWindow(w, PMONITOR))
+            continue;
+        return true;
+    }
+
+    // close/fade-out animations of hidden windows live outside the window list
+    for (auto const& f : Desktop::fadingOutState()->fadeouts()) {
+        if (f && f->monitor() == PMONITOR && f->source().noScreenShare)
+            return true;
+    }
+
+    return false;
+}
