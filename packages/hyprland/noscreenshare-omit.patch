+// Instead of copying the finished monitor texture and painting black boxes over no_screen_share content,
+// render the monitor scene again in capture mode. In capture mode the renderer skips those windows/layers
+// (including shadows, borders, popups), so what was underneath them shows up in the capture.
+void CScreenshareFrame::renderMonitorOmitHidden(Render::CRenderContext& ctx) {
+    const auto PMONITOR = m_session->monitor();
+    const auto NOW      = Time::steadyNow();
+
+    ctx.m_data.fbSize = m_bufferSize;
+    g_pHyprRenderer->setProjectionType(ctx, Render::RPT_EXPORT);
+    ctx.m_data.transformDamage = false;
+    ctx.m_data.noSimplify      = true;
+    g_pHyprRenderer->setViewport(0, 0, m_bufferSize.x, m_bufferSize.y);
+
+    // geometry shifted by the capture region origin, same size as the monitor -> scale stays 1
+    const CBox GEOMETRY = {-m_session->m_captureBox.x, -m_session->m_captureBox.y, static_cast<int>(PMONITOR->m_transformedSize.x), static_cast<int>(PMONITOR->m_transformedSize.y)};
+
+    g_pHyprRenderer->startRenderPass(ctx);
+    g_pHyprRenderer->renderWorkspace(ctx, PMONITOR, PMONITOR->m_activeWorkspace, NOW, GEOMETRY);
+    g_pHyprRenderer->renderIME(ctx, PMONITOR, NOW, GEOMETRY);
+
+    if (m_overlayCursor) {
+        CRegion  fakeDamage = {0, 0, m_bufferSize.x, m_bufferSize.y};
+        Vector2D cursorPos  = Pointer::mgr()->untransformedPosition() - PMONITOR->m_position - m_session->m_captureBox.pos() / PMONITOR->m_scale;
+        Pointer::mgr()->renderSoftwareCursorsFor(ctx, PMONITOR, NOW, fakeDamage, cursorPos, true);
+    }
+}
